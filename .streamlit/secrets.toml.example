# ================================================================
# KONFIGURASI KONEKSI GOOGLE SHEETS (STREAMLIT SECRETS)
# ================================================================
# Cara Penggunaan:
# 1. Salin file ini menjadi 'secrets.toml' di dalam folder '.streamlit/'
# 2. Masukkan URL Google Sheets yang dapat diakses publik atau tambahkan kredensial service account.

[connections.gsheets]
spreadsheet = "https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID_HERE/edit#gid=0"
worksheet = "Sheet1"
